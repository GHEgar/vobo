# Cuentas de prueba del entorno a validar, una por línea: correo=contraseña. Las líneas vacías o con # se ignoran.
# La descripción de cada cuenta sale de cuentas[].prefijo en instancia.yaml.
<val-admin-01@dominio-de-pruebas>=<contraseña de la cuenta>
<val-cliente-01@dominio-de-pruebas>=<contraseña de la cuenta>
