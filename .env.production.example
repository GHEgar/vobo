# Variables de producción (make deploy). Los secretos viven en secrets/.

APP_ENV=<prod>
AUTH_MODO=<oidc; local se rechaza fuera de desarrollo>
SESSION_COOKIE_SECURE=<true detrás de HTTPS, false si se entra por HTTP>

DOMINIO=<validaciones.ejemplo>
DOMINIO_IDP=<idp.ejemplo>
SITIO=https://${DOMINIO}
FRONTEND_URL=${SITIO}
ALLOWED_ORIGINS=${SITIO}

# IP del servidor: nginx la acepta como server_name además de ${DOMINIO}
VM_IP=<ip del servidor>
NGINX_BIND_ADDR=<0.0.0.0 o la ip del servidor>
NGINX_PORT=<80>

# Nombre del proyecto de compose y de los volúmenes de datos; cambiarlos en una instancia
# existente crea volúmenes nuevos y vacíos
COMPOSE_NOMBRE=<validaciones>
VOLUMEN_DATOS=<validaciones_datos>
VOLUMEN_EVIDENCIAS=<validaciones_evidencias>

# Carpeta con instancia.yaml, secciones/, procedimientos*.yaml y media/ de esta instancia
CONTENIDO_DIR=<ruta al contenido de esta instancia>
# Carpeta con tema.css y sus fuentes; vacía usa el tema neutro de frontend/public/tema
TEMA_DIR=<ruta al tema de esta instancia>

OIDC_ISSUER_URL=<url del proveedor desde el servidor, p. ej. http://${DOMINIO_IDP}:3000>
OIDC_PUBLIC_URL=<https://${DOMINIO_IDP}, o vacía si es la misma>
OIDC_EXPECTED_ISSUER=<iss de los tokens, o vacía para usar el issuer del discovery>
OIDC_CLIENT_ID=<client_id de esta aplicación en el proveedor>
OIDC_REDIRECT_URI=<${SITIO}/api/auth/callback, registrada tal cual en el proveedor>
OIDC_AUDIENCE=<aud que debe traer el access token, p. ej. validacion>
OIDC_SCOPE=openid profile email
OIDC_TOKEN_TYP=<claim typ exigida en el access token, p. ej. access, o vacía>
# Si se deja vacía, los permisos se leen de la claim OIDC_PERMISOS_CLAIM del access token
OIDC_PERMISOS_URL=<GET con Bearer que responde {"permissions": [...]}, o vacía>
OIDC_PERMISOS_CLAIM=permissions
