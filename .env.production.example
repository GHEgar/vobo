# Variables de producción (make deploy). make instalar crea .env.production desde esta plantilla; los secretos viven en secrets/

APP_ENV=<prod>

# imagen: descarga las imágenes publicadas de VOBO_VERSION (no compila nada); codigo: construye las
# imágenes en este servidor desde el árbol actual. Vacía equivale a codigo en un clon e imagen en el kit
MODO_DESPLIEGUE=<imagen o codigo>
# Versión publicada que corre en modo imagen; make actualizar version=X.Y.Z la cambia
VOBO_VERSION=<versión publicada, p. ej. 0.3.0>
# Repositorio de cada imagen sin tag; vacías usan las públicas
VOBO_IMAGEN_BACKEND=
VOBO_IMAGEN_WEB=
# oidc: proveedor de identidad; cuentas: correo y contraseña propios (primer admin con make admin);
# ambos: las dos; local se rechaza fuera de desarrollo
AUTH_MODO=<oidc, cuentas o ambos>
SESSION_COOKIE_SECURE=<true detrás de HTTPS, false si se entra por HTTP>

DOMINIO=<vobo.ejemplo>
DOMINIO_IDP=<idp.ejemplo>
SITIO=https://${DOMINIO}
FRONTEND_URL=${SITIO}
ALLOWED_ORIGINS=${SITIO}

# IP del servidor: nginx la acepta como server_name además de ${DOMINIO}
VM_IP=<ip del servidor>
NGINX_BIND_ADDR=<0.0.0.0 o la ip del servidor>
NGINX_PORT=<80>

# Nombre del proyecto de compose y de los volúmenes de datos; cambiarlos en una instancia
# existente crea volúmenes nuevos y vacíos
COMPOSE_NOMBRE=<vobo>
VOLUMEN_DATOS=<vobo_datos>
VOLUMEN_EVIDENCIAS=<vobo_evidencias>

# Carpeta con instancia.yaml, secciones/, procedimientos*.yaml y media/ de esta instancia
CONTENIDO_DIR=<ruta al contenido de esta instancia>
# De dónde sale el contenido: archivos (por omisión, lee CONTENIDO_DIR tal cual) o base (lo guarda
# en SQLite, se edita desde /editor y la primera vez importa CONTENIDO_DIR); las animaciones subidas
# viven en el volumen VOLUMEN_MEDIA
CONTENIDO_FUENTE=<archivos o base>
# Volumen de las animaciones subidas desde el editor; cambiarlo en una instancia existente crea uno vacío
VOLUMEN_MEDIA=<vobo_media>
# Carpeta con tema.css y sus fuentes; vacía usa el tema neutro de frontend/public/tema
TEMA_DIR=<ruta al tema de esta instancia>
# APP_VERSION no va aquí: en modo imagen es VOBO_VERSION, horneada en las imágenes; en modo codigo
# make deploy la calcula (hash corto y hora del build). Los logos subidos desde la app viven en el
# volumen de datos (/data/marca)

# Con AUTH_MODO=cuentas las OIDC_* pueden ir vacías
OIDC_ISSUER_URL=<url del proveedor desde el servidor, p. ej. http://${DOMINIO_IDP}:3000>
OIDC_PUBLIC_URL=<https://${DOMINIO_IDP}, o vacía si es la misma>
OIDC_EXPECTED_ISSUER=<iss de los tokens, o vacía para usar el issuer del discovery>
OIDC_CLIENT_ID=<client_id de esta aplicación en el proveedor>
OIDC_REDIRECT_URI=<${SITIO}/api/auth/callback, registrada tal cual en el proveedor>
OIDC_AUDIENCE=<aud que debe traer el access token, p. ej. validacion>
OIDC_SCOPE=openid profile email
OIDC_TOKEN_TYP=<claim typ exigida en el access token, p. ej. access, o vacía>
# Si se deja vacía, los permisos se leen de la claim OIDC_PERMISOS_CLAIM del access token
OIDC_PERMISOS_URL=<GET con Bearer que responde {"permissions": [...]}, o vacía>
OIDC_PERMISOS_CLAIM=permissions
# Roles de la app concedidos por grupos del proveedor: claim del access token con los grupos
# (p. ej. groups) y mapa JSON de grupo a clave de rol; vacías no mapean nada
OIDC_ROLES_CLAIM=<claim con los grupos, p. ej. groups, o vacía>
OIDC_ROLES_MAPA=<{"grupo-proveedor": "clave-rol"}, o vacía>
