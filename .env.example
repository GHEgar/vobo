# Variables de desarrollo (make up). Producción usa .env.production; plantilla en .env.production.example.
# Los secretos no van aquí: viven en secrets/ y los crea make setup.

APP_ENV=<dev>
# local muestra un selector de usuarios de prueba y solo se acepta con APP_ENV=dev; oidc usa el proveedor
# de identidad; cuentas usa correo y contraseña propios de la app; ambos ofrece cuentas y proveedor
AUTH_MODO=<local, oidc, cuentas o ambos>
SESSION_COOKIE_SECURE=<false en desarrollo por HTTP>

DOMINIO=<host desde el navegador, p. ej. localhost:5173>
SITIO=http://${DOMINIO}
FRONTEND_URL=${SITIO}
ALLOWED_ORIGINS=${SITIO}

VITE_DEV_PORT=<puerto de Vite, p. ej. 5173>
FRONTEND_BIND_ADDR=<127.0.0.1 para solo este equipo>
BACKEND_PORT=<puerto publicado del backend, p. ej. 8010>
BACKEND_BIND_ADDR=<127.0.0.1 para solo este equipo>

# Carpeta con instancia.yaml, secciones/, procedimientos*.yaml y media/; vacía usa ./ejemplo/contenido
CONTENIDO_DIR=
# De dónde sale el contenido: archivos (por omisión, lee CONTENIDO_DIR tal cual) o base (lo guarda
# en SQLite, se edita desde /editor y la primera vez importa CONTENIDO_DIR); las animaciones subidas
# viven en el volumen VOLUMEN_MEDIA
CONTENIDO_FUENTE=<archivos o base>
# Carpeta con tema.css y sus fuentes; vacía usa el tema neutro de frontend/public/tema
TEMA_DIR=

# Con AUTH_MODO=local o cuentas pueden ir vacías
OIDC_ISSUER_URL=<url del proveedor desde el servidor, p. ej. http://idp.ejemplo:3000, o vacía>
OIDC_PUBLIC_URL=<url del proveedor desde el navegador, o vacía si es la misma>
OIDC_EXPECTED_ISSUER=<iss de los tokens, o vacía para usar el issuer del discovery>
OIDC_CLIENT_ID=<client_id de esta aplicación en el proveedor, o vacía>
OIDC_REDIRECT_URI=<${SITIO}/api/auth/callback, o vacía>
OIDC_AUDIENCE=<aud que debe traer el access token, o vacía>
OIDC_SCOPE=openid profile email
OIDC_TOKEN_TYP=<claim typ exigida en el access token, o vacía para no exigirla>
# Si se deja vacía, los permisos se leen de la claim OIDC_PERMISOS_CLAIM del access token
OIDC_PERMISOS_URL=<GET con Bearer que responde {"permissions": [...]}, o vacía>
OIDC_PERMISOS_CLAIM=permissions
# Roles de la app concedidos por grupos del proveedor: claim del access token con los grupos
# (p. ej. groups) y mapa JSON de grupo a clave de rol; vacías no mapean nada
OIDC_ROLES_CLAIM=<claim con los grupos, p. ej. groups, o vacía>
OIDC_ROLES_MAPA=<{"grupo-proveedor": "clave-rol"}, o vacía>
